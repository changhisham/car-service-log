# Copy this file to .env and fill in the values from your Firebase
# project's web app config (Firebase console > Project settings > Your apps).
# See README.md "Step 2" for exactly where to find these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

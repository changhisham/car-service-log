rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in user matching {userId} can read/write their own
    // documents. Real authentication (Google/email) means the UID is
    // permanent and tied to a real login, so this can be locked down
    // properly — unlike the earlier anonymous+shared-ID setup where any
    // signed-in (even anonymous) visitor had to be allowed through.
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
